# Credenciales y puertos de ShardShop.
# Copia este archivo a `.env` (que está en .gitignore) y ajusta los valores.
# El stack completo (coordinator, workers y db_usuarios) usa el mismo usuario.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# trust = sin contraseña entre nodos (cómodo en local). Cambiar en entornos reales.
POSTGRES_HOST_AUTH_METHOD=trust

# Puerto del host para el coordinator de Citus.
COORDINATOR_PORT=5432
# Puerto del host para el PostgreSQL independiente de usuarios (sharding vertical).
DB_USUARIOS_PORT=5433
